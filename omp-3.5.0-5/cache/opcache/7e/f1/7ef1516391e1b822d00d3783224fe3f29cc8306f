1825506994a:3:{s:6:"domain";N;s:12:"plural-forms";s:26:"nplurals=2; plural=n != 1;";s:8:"messages";a:1:{s:0:"";a:38:{s:20:"admin.hostedContexts";s:36:"Ylläpidetyt julkaisijoiden sivustot";s:33:"admin.settings.appearance.success";s:52:"Sivuston ulkoasua koskevat asetukset on päivitetty.";s:29:"admin.settings.config.success";s:34:"Sivuston asetukset on päivitetty.";s:27:"admin.settings.info.success";s:51:"Sivuston tietoja koskevat asetukset on päivitetty.";s:23:"admin.settings.redirect";s:36:"Julkaisijan sivuston uudelleenohjaus";s:35:"admin.settings.redirectInstructions";s:76:"Koko sivustoon kohdistuvat pyynnöt ohjataan tämän julkaisijan sivustolle.";s:30:"admin.settings.noPressRedirect";s:20:"Älä uudelleenohjaa";s:41:"admin.languages.primaryLocaleInstructions";s:106:"Tätä kieltä käytetään sivuston ja kaikkien ylläpidettyjen julkaisijoiden sivustojen oletuskielenä.";s:44:"admin.languages.supportedLocalesInstructions";s:416:"Valitse kaikki sivustolla tuettavat kielialueet. Valitut kielialueet ovat kaikkien sivustolla ylläpidettävien julkaisijoiden käytössä. Ne esiintyvät myös kielivalikossa, joka näkyy jokaisella sivuston sivulla (tämä voidaan ohittaa julkaisijoiden omilla sivuilla). Mikäli valitaan vain yksi kielialue, kielivalikko ei tule näkyviin ja laajennetut kieliasetukset eivät ole julkaisijoiden käytettävissä.";s:28:"admin.locale.maybeIncomplete";s:64:"Tähdellä (*) merkityt kielialueet saattavat olla vaillinaisia.";s:32:"admin.languages.confirmUninstall";s:123:"Haluatko varmasti poistaa tämän kielialueen? Se saattaa vaikuttaa julkaisijoihin, joilla on tämä kielialue käytössä.";s:45:"admin.languages.installNewLocalesInstructions";s:259:"Valitse mitä tahansa lisäkielialueita, joille asennetaan tuki tässä järjestelmässä. Kielialueet täytyy asentaa ennen kuin ylläpidetyt julkaisijat voivat käyttää niitä. Katso OMP:n ohjeista tietoja siitä, kuinka uusille kielille lisätään tuki.";s:30:"admin.languages.confirmDisable";s:135:"Haluatko varmasti poistaa tämän kielialueen käytöstä? Se saattaa vaikuttaa julkaisijoihin, joilla on tämä kielialue käytössä.";s:19:"admin.systemVersion";s:10:"OMP-versio";s:25:"admin.systemConfiguration";s:16:"OMP:n määritys";s:27:"admin.presses.pressSettings";s:21:"Julkaisijan asetukset";s:25:"admin.presses.noneCreated";s:43:"Yhtään julkaisijan sivustoa ei ole luotu.";s:21:"admin.contexts.create";s:23:"Luo julkaisijan sivusto";s:33:"admin.contexts.form.titleRequired";s:18:"Otsikko vaaditaan.";s:32:"admin.contexts.form.pathRequired";s:16:"Polku vaaditaan.";s:36:"admin.contexts.form.pathAlphaNumeric";s:147:"Polku voi sisältää vain aakkosnumeerisia merkkejä, alaviivoja ja yhdysmerkkejä, ja sen täytyy alkaa ja päättyä aakkosnumeeriseen merkkiin.";s:30:"admin.contexts.form.pathExists";s:60:"Valittu polku on jo toisen julkaisijan sivuston käytössä.";s:45:"admin.contexts.form.primaryLocaleNotSupported";s:85:"Pääasiallisen kielen tulee olla yksi julkaisijan sivuston käyttämistä kielistä.";s:34:"admin.contexts.form.create.success";s:30:"{$name} luotiin onnistuneesti.";s:32:"admin.contexts.form.edit.success";s:36:"{$name} päivitettiin onnistuneesti.";s:33:"admin.contexts.contextDescription";s:18:"Julkaisijan kuvaus";s:22:"admin.presses.addPress";s:27:"Lisää julkaisijan sivusto";s:37:"admin.overwriteConfigFileInstructions";s:255:"<h4>HUOM!</div>
<p>Järjestelmä ei voinut korvata määritystiedostoa automaattisesti. Ottaaksesi määritysmuutokset käyttöön avaa <tt>config.inc.php</tt> sopivassa tekstieditorissa ja korvaa sen sisältö alla olevan tekstikentän sisällöllä.</p>";s:43:"admin.settings.enableBulkEmails.description";s:793:"Valitse ne julkaisijoiden sivustot, joiden sallitaan lähettää massasähköposteja. Kun tämä ominaisuus on päällä, julkaisijan sivuston hallinnoija pystyy lähettämään sähköpostin kaikille sivustolleen rekisteröityneille käyttäjille.<br><br>Ominaisuuden väärinkäyttö voi rikkoa massasähköposteja koskevaa lainsäädäntöä ja voi edesauttaa sähköpostipalvelimelta lähtevien viestien päätymistä roskapostiksi. Ennen ominaisuuden käyttöönottoa kysy tarvittaessa neuvoa tekniseltä asiantuntijalta ja keskustele ominaisuuden oikeaoppisesta käytöstä sivustosi julkaisijoiden kanssa. <br><br>Ominaisuuden käyttöä voi rajoittaa tarkemmin julkaisijan sivuston asetuksista, joihin pääset <a href="{$hostedContextsUrl}">julkaisijoiden sivustojen listauksesta</a>.";s:48:"admin.settings.disableBulkEmailRoles.description";s:526:"Julkaisijan sivuston hallinnoija ei pysty lähettämään massasähköposteja alla valituille rooleille. Tätä asetusta voi käyttää massasähköpostien väärinkäytösten rajoittamiseen. Esimerkiksi, voi olla kannattavaa rajoittaa lukijoille, kirjoittajille tai muille suurille käyttäjäryhmille lähetettäviä viestejä, jos he eivät ole antaneet lupaa sellaisten lähettämiseen.<br><br>Massasähköpostit voi ottaa kokonaan pois käytöstä kohdasta <a href="{$siteSettingsUrl}">Ylläpito > Sivuston asetukset</a>.";s:52:"admin.settings.disableBulkEmailRoles.contextDisabled";s:174:"Massasähköpostit on poistettu käytöstä tämän julkaisijan sivustolla. Ota toiminto käyttöön kohdasta <a href="{$siteSettingsUrl}">Ylläpito > Sivuston asetukset</a>.";s:32:"admin.siteManagement.description";s:97:"Lisää, muokkaa tai poista julkaisijoita tältä sivustolta ja hallitse koko sivuston asetuksia.";s:50:"admin.job.processLogFile.invalidLogEntry.chapterId";s:35:"Luvun ID-tunnus ei ole kokonaisluku";s:49:"admin.job.processLogFile.invalidLogEntry.seriesId";s:36:"Sarjan ID-tunnus ei ole kokonaisluku";s:41:"admin.settings.statistics.geo.description";s:632:"Valitse, minkä tyyppisiä maantieteellisiä käyttötilastoja tämän sivuston julkaisijat voivat kerätä. Yksityiskohtaisemmat maantieteelliset tilastot saattavat kasvattaa tietokannan kokoa huomattavasti ja joissakin harvoissa tapauksissa heikentää kävijöiden anonymiteettiä. Kukin julkaisija voi määrittää tämän asetuksen eri tavalla, mutta julkaisija ei voi koskaan kerätä yksityiskohtaisempia tietueita kuin mitä tässä on määritetty. Jos sivusto esimerkiksi tukee vain maata ja aluetta, julkaisija voi valita esimerkiksi maan ja alueen tai vain maan. Julkaisija ei voi tallentaa maata, aluetta ja kaupunkia.";s:50:"admin.settings.statistics.institutions.description";s:327:"Ota käyttöön instituutiotilastot, jos haluat, että tämän sivuston julkaisijat voivat kerätä instituutiokohtaisia käyttötilastoja. Julkaisijoiden on lisättävä instituutio ja sen IP-alueet voidakseen käyttää tätä ominaisuutta. Instituutiotilastojen käyttöönotto voi kasvattaa tietokannan kokoa huomattavasti.";s:50:"admin.settings.statistics.sushi.public.description";s:311:"Asetetaanko SUSHI API julkisesti saataville kaikissa tämän sivuston julkaisijoille. Jos otat julkisen API:n käyttöön, kukin julkaisija voi ohittaa tämän asetuksen tehdäkseen tilastonsa yksityisiksi. Jos kuitenkin poistat julkisen API:n käytöstä, julkaisijat eivät voi tehdä omasta API:sta julkista.";s:59:"admin.settings.statistics.sushiPlatform.isSiteSushiPlatform";s:61:"Käytä sivustoa kaikkien julkaisijoiden sivustojen alustana.";}}}