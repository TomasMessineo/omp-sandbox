1825506995a:3:{s:6:"domain";N;s:12:"plural-forms";s:26:"nplurals=2; plural=n != 1;";s:8:"messages";a:1:{s:0:"";a:38:{s:30:"admin.settings.noPressRedirect";s:33:"Шилжүүлэг хийхгүй";s:41:"admin.languages.primaryLocaleInstructions";s:133:"Энэ нь сайт болон байршуулсан хэвлэлийн газруудын үндсэн хэл байх болно.";s:44:"admin.languages.supportedLocalesInstructions";s:695:"Сайт дээр дэмжих бүх локалуудыг (хэл) сонгоно уу. Сонгосон локалууд нь сайт дээрх бүх хэвлэлийн газруудад ашиглах боломжтой болох бөгөөд хуудас бүрийн хэл сонгох цэсэнд харагдах болно (үүнийг хэвлэлийн газар тус бүрийн тохиргоон дээр өөрчилж болно). Хэрэв олон локал сонгохгүй бол хэл солих цэс харагдахгүй бөгөөд хэлний өргөтгөсөн тохиргоо хэвлэлийн газруудад боломжгүй болно.";s:28:"admin.locale.maybeIncomplete";s:79:"* Тэмдэглэсэн локалууд дутуу байж магадгүй.";s:32:"admin.languages.confirmUninstall";s:229:"Та энэ локалыг устгахдаа итгэлтэй байна уу? Энэ нь уг локалыг ашиглаж буй байршуулсан хэвлэлийн газруудад нөлөөлж болзошгүй.";s:45:"admin.languages.installNewLocalesInstructions";s:326:"Энэ системд суулгах нэмэлт локалуудыг сонгоно уу. Хэвлэлийн газрууд ашиглахаас өмнө локалуудыг суулгасан байх ёстой. Шинэ хэл нэмэх талаарх мэдээллийг OMP баримт бичгээс үзнэ үү.";s:30:"admin.languages.confirmDisable";s:255:"Та энэ локалыг идэвхгүй болгохдоо итгэлтэй байна уу? Энэ нь одоо уг локалыг ашиглаж буй байршуулсан хэвлэлийн газруудад нөлөөлж болзошгүй.";s:25:"admin.systemConfiguration";s:20:"OMP тохиргоо";s:27:"admin.presses.pressSettings";s:48:"Хэвлэлийн газрын тохиргоо";s:25:"admin.presses.noneCreated";s:72:"Ямар ч хэвлэлийн газар үүсгээгүй байна.";s:21:"admin.contexts.create";s:42:"Хэвлэлийн газар үүсгэх";s:33:"admin.contexts.form.titleRequired";s:38:"Гарчиг шаардлагатай.";s:32:"admin.contexts.form.pathRequired";s:39:"Зам (path) шаардлагатай.";s:36:"admin.contexts.form.pathAlphaNumeric";s:192:"Зам нь зөвхөн үсэг, тоо болон _ ба - тэмдэгтүүдийг агуулж болно. Мөн үсэг эсвэл тоогоор эхэлж, төгсөх ёстой.";s:30:"admin.contexts.form.pathExists";s:111:"Таны оруулсан зам өөр хэвлэлийн газар дээр ашиглагдаж байна.";s:45:"admin.contexts.form.primaryLocaleNotSupported";s:130:"Үндсэн локал нь хэвлэлийн газрын дэмжигдсэн локалуудын нэг байх ёстой.";s:34:"admin.contexts.form.create.success";s:48:"{$name} амжилттай үүсгэгдлээ.";s:32:"admin.contexts.form.edit.success";s:54:"{$name} амжилттай засварлагдлаа.";s:33:"admin.contexts.contextDescription";s:46:"Хэвлэлийн газрын тайлбар";s:22:"admin.presses.addPress";s:40:"Хэвлэлийн газар нэмэх";s:37:"admin.overwriteConfigFileInstructions";s:441:"<h4>АНХААР!</h4>
<p>Систем тохиргооны файлыг автоматаар дарж бичиж чадсангүй. Тохиргооны өөрчлөлтийг хэрэгжүүлэхийн тулд та <tt>config.inc.php</tt> файлыг текст засварлагчаар нээж, агуулгыг нь доорх текстийн талбарт байгаа текстээр солих шаардлагатай.</p>";s:43:"admin.settings.enableBulkEmails.description";s:1113:"Олноор имэйл илгээхийг зөвшөөрөх байршуулсан хэвлэлийн газруудыг сонгоно уу. Энэ функц идэвхжсэн үед хэвлэлийн газрын менежер өөрийн газар бүртгэлтэй бүх хэрэглэгчдэд имэйл илгээх боломжтой болно.<br><br>Энэ функцийг хүсээгүй имэйл (спам) илгээхэд ашиглах нь зарим улс орны спам эсэргүүцэх хуулийг зөрчиж, танай серверийн имэйлүүд блоклогдоход хүргэж болзошгүй. Энэ функцийг идэвхжүүлэхээс өмнө техникийн зөвлөгөө авч, менежерүүдтэй зөвлөлдөнө үү.<br><br>Энэ функцийн нэмэлт хязгаарлалтыг <a href="{$hostedContextsUrl}">Байршуулсан хэвлэлийн газрууд</a> жагсаалт дахь хэвлэлийн газар бүрийн тохиргооны хэсгээс хийж болно.";s:48:"admin.settings.disableBulkEmailRoles.description";s:981:"Хэвлэлийн газрын менежер доор сонгосон үүрэгт (роль) хамаарах хэрэглэгчид рүү олноор имэйл илгээх боломжгүй болно. Имэйл мэдэгдлийн функцийг зүй бусаар ашиглахаас сэргийлэхийн тулд энэ тохиргоог ашиглана уу. Жишээлбэл, ийм имэйл хүлээн авахыг зөвшөөрөөгүй уншигчид, зохиогчид эсвэл бусад том хэрэглэгчийн бүлгүүд рүү олноор имэйл илгээхийг идэвхгүй болгох нь илүү аюулгүй байж магадгүй юм.<br><br>Олноор имэйл илгээх функцийг энэ хэвлэлийн газрын хувьд <a href="{$siteSettingsUrl}">Админ > Сайтын тохиргоо</a> хэсгээс бүрмөсөн идэвхгүй болгож болно.";s:52:"admin.settings.disableBulkEmailRoles.contextDisabled";s:293:"Энэ хэвлэлийн газрын хувьд олноор имэйл илгээх функцийг идэвхгүй болгосон байна. Энэ функцийг <a href="{$siteSettingsUrl}">Админ > Сайтын тохиргоо</a> хэсгээс идэвхжүүлнэ үү.";s:32:"admin.siteManagement.description";s:179:"Энэ сайтаас хэвлэлийн газар нэмэх, засварлах эсвэл хасах, мөн сайтын хэмжээний тохиргоог удирдах.";s:50:"admin.job.processLogFile.invalidLogEntry.chapterId";s:68:"Бүлгийн (Chapter) ID нь бүхэл тоо биш байна";s:49:"admin.job.processLogFile.invalidLogEntry.seriesId";s:69:"Цувралын (Series) ID нь бүхэл тоо биш байна";s:41:"admin.settings.statistics.geo.description";s:1020:"Энэ сайт дээрх хэвлэлийн газруудын цуглуулж болох газарзүйн ашиглалтын статистикийн төрлийг сонгоно уу. Илүү нарийвчилсан газарзүйн статистик нь таны өгөгдлийн сангийн хэмжээг мэдэгдэхүйц нэмэгдүүлж, зарим ховор тохиолдолд зочдын нууцлалд нөлөөлж болзошгүй. Хэвлэлийн газар бүр энэ тохиргоог өөрөөр тохируулж болох боловч энд тохируулснаас илүү нарийвчилсан мэдээлэл цуглуулах боломжгүй. Жишээлбэл, хэрэв сайт зөвхөн улс болон бүсийг дэмждэг бол хэвлэлийн газар нь улс болон бүс, эсвэл зөвхөн улсыг сонгож болно. Улс, бүс, хотыг хянах боломжгүй болно.";s:50:"admin.settings.statistics.institutions.description";s:621:"Хэрэв та энэ сайт дээрх хэвлэлийн газруудыг байгууллагаар нь ашиглалтын статистик цуглуулах боломжтой болгохыг хүсвэл байгууллагын статистикийг идэвхжүүлнэ үү. Үүний тулд байгууллага болон түүний IP мужийг нэмэх шаардлагатай болно. Байгууллагын статистикийг идэвхжүүлэх нь өгөгдлийн сангийн хэмжээг мэдэгдэхүйц нэмэгдүүлж болзошгүй.";s:50:"admin.settings.statistics.sushi.public.description";s:607:"SUSHI API хандалтын цэгүүдийг энэ сайтын бүх хэвлэлийн газруудад нээлттэй болгох эсэхийг сонгоно уу. Хэрэв та нээлттэй API-г идэвхжүүлбэл хэвлэлийн газар бүр өөрийн статистикийг нууцлахын тулд энэ тохиргоог өөрчилж болно. Гэсэн хэдий ч, хэрэв та нээлттэй API-г идэвхгүй болговол хэвлэлийн газрууд өөрсдийн API-г нээлттэй болгох боломжгүй.";s:59:"admin.settings.statistics.sushiPlatform.isSiteSushiPlatform";s:103:"Сайтыг бүх хэвлэлийн газруудын платформ болгон ашиглах.";s:20:"admin.hostedContexts";s:56:"Байршуулсан хэвлэлийн газрууд";s:33:"admin.settings.appearance.success";s:104:"Сайтын харагдах байдлын тохиргоог амжилттай шинэчиллээ.";s:29:"admin.settings.config.success";s:103:"Сайтын тохиргооны үзүүлэлтүүдийг амжилттай шинэчиллээ.";s:27:"admin.settings.info.success";s:74:"Сайтын мэдээллийг амжилттай шинэчиллээ.";s:23:"admin.settings.redirect";s:66:"Хэвлэлийн газар руу шилжүүлэх (Redirect)";s:35:"admin.settings.redirectInstructions";s:337:"Үндсэн сайт руу ирсэн хүсэлтүүдийг энэ хэвлэлийн газар руу шууд шилжүүлэх болно. Энэ нь жишээлбэл, сайт зөвхөн ганц хэвлэлийн газар байршуулж байгаа тохиолдолд хэрэгтэй байж болох юм.";s:19:"admin.systemVersion";s:20:"OMP хувилбар";}}}