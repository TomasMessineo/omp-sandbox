1825506995a:3:{s:6:"domain";N;s:12:"plural-forms";s:43:"nplurals=2; plural=n==1 || n%10==1 ? 0 : 1;";s:8:"messages";a:1:{s:0:"";a:38:{s:20:"admin.hostedContexts";s:25:"Наши Изданија";s:33:"admin.settings.appearance.success";s:108:"Подесувањата за изгледот на страната се успешно ажурирани.";s:29:"admin.settings.config.success";s:118:"Поставките за конфигурација на страницата се успешно ажурирани.";s:27:"admin.settings.info.success";s:90:"Информациите за страницата се успешно ажурирани.";s:23:"admin.settings.redirect";s:48:"Пренасочување кон издание";s:35:"admin.settings.redirectInstructions";s:265:"Барањата до главната страница ќе бидат пренасочени кон ова издание. Ова може да биде корисно доколку страницата има само едно издание, на пример.";s:30:"admin.settings.noPressRedirect";s:29:"Не пренасочувај";s:41:"admin.languages.primaryLocaleInstructions";s:153:"Ова ќе биде основниот јазик за страната и сите изданија што се зачувани на страната.";s:44:"admin.languages.supportedLocalesInstructions";s:799:"Изберете ги сите локации за поддршка на страницата. Избраните локации ќе бидат достапни за употреба од сите изданија зачувани на страницата, и исто така ќе се појават во менито за избирање на јазик на секоја страница на страната(што може да се пребрише на страници специфични за изданието). Ако повеќе локации не се избрани, менито за промена на јазик нема да се појави и проширените поставки за јазик нема да бидат достапни за изданијата.";s:28:"admin.locale.maybeIncomplete";s:82:"* Означените локации може да бидат нецелосни.";s:32:"admin.languages.confirmUninstall";s:234:"Дали сте сигурни дека сакате да ја избришете оваа локација? Ова може да влијае на сите изданија што се зачувани на оваа локација.";s:45:"admin.languages.installNewLocalesInstructions";s:454:"Изберете дополнителни локации за инсталирање поддршка на овој систем. Локациите мора да бидат инсталирани пред да можат да се користат од зачуваните изданија. Погледнете ја документацијата на ОМП за информации за додавање поддршка за нови јазици.";s:30:"admin.languages.confirmDisable";s:247:"Дали сте сигурни дека сакате да ја оневозможите оваа локација? Ова може да влијае на сите зачувани изданија кои ја користат локацијата.";s:19:"admin.systemVersion";s:21:"ОМП Верзија";s:25:"admin.systemConfiguration";s:33:"ОМП Конфигурација";s:27:"admin.presses.pressSettings";s:40:"Подесувања на Издание";s:25:"admin.presses.noneCreated";s:46:"Не се создадени изданија.";s:21:"admin.contexts.create";s:29:"Креирај Издание";s:33:"admin.contexts.form.titleRequired";s:33:"Потребен е наслов.";s:32:"admin.contexts.form.pathRequired";s:33:"Потребна е патека.";s:36:"admin.contexts.form.pathAlphaNumeric";s:186:"Патеката може да вклучува само букви, броеви и знаци _ и -. Мора да започне и да заврши со буква или број.";s:30:"admin.contexts.form.pathExists";s:100:"Селектираната патека веќе се користи за друго издание.";s:45:"admin.contexts.form.primaryLocaleNotSupported";s:125:"Главниот локал мора да биде еден од поддржаните локали на изданието.";s:34:"admin.contexts.form.create.success";s:44:"{$ name} е успешно креирано.";s:32:"admin.contexts.form.edit.success";s:44:"{$ name} е успешно изменето.";s:33:"admin.contexts.contextDescription";s:28:"Опис на издание";s:22:"admin.presses.addPress";s:27:"Додади Издание";s:37:"admin.overwriteConfigFileInstructions";s:508:"<h4> ЗАБЕЛЕШКА! </div>
<p> Системот не може автоматски да ја замени конфигурациската датотека. За да ги примените промените во конфигурацијата, мора да отворите <tt> config.inc.php </tt> во соодветен уредувач на текст и да ја замените неговата содржина со содржината на полето за текст подолу. </p>";s:43:"admin.settings.enableBulkEmails.description";s:1440:"Изберете ги хостираните изданија на кои треба да им биде дозволено да испраќаат и-меил во големи количини. Кога е овозможена оваа функција, менаџерот на изданието ќе може да испраќа и-меил до сите корисници регистрирани на нивното издание.<br><br>Злоупотреба на оваа функција како би се испраќала непосакувана е-пошта може да ги прекрши анти-спам законите во некои подрачја и може да доведе до блокирање на е-поштата од вашиот сервер како спам. Побарајте техничко мислење пред да ја овозможите оваа функција и размислете за консултација до менџери на изданија за да се уверите дека е правилно користена. <br><br>Дополнителни ограничувања на оваа функција може да бидат овозможени за секое издание со посета на неговиот волшебник за поставки во листата со <a href="{$hostedContextsUrl}">Хостирани изданија</a>.";s:48:"admin.settings.disableBulkEmailRoles.description";s:1070:"Менаџерот на изданието нема да може да испраќа е-пошта во големи количини до било која од избраните улоги подолу. Користете ја оваа поставка за да ја ограничите злоупотребата на функцијата за известувања преку е-пошта. На пример, можно е да биде побезбедно да оневозможите испраќање на е-пошта во големи количини до читатели, автори, или други големи групи на корисници кои не се согласиле да примаат таква е-пошта.<br><br>Функцијата за испраќање е-пошта во големи количини за ова издание може да биде целосно оневозможена преку <a href="{$siteSettingsUrl}">Администратор > Поставки на веб-страницата</a>.";s:52:"admin.settings.disableBulkEmailRoles.contextDisabled";s:325:"Функцијата за испраќање е-пошта во големи количини е оневозможена за ова издание. Овозможете ја оваа функција преку <a href="{$siteSettingsUrl}">Администратор > Поставки на веб-страницата</a>.";s:32:"admin.siteManagement.description";s:162:"Додади, корегирај или отстрани книги од овој сајт и менаџирај ги проширените подесувања.";s:50:"admin.job.processLogFile.invalidLogEntry.chapterId";s:54:"ИД на поглавјето не е цел број";s:49:"admin.job.processLogFile.invalidLogEntry.seriesId";s:50:"ИД на серијата не е цел број";s:41:"admin.settings.statistics.geo.description";s:906:"Одбери вид географска употреба на статитистика која може да ги опфати објавите во овој сајт. Подетална географска статистика може значајно да ја зголеми вашата база на податоци, а, во некои случаи, може да ја поткопа анонимноста на вашите посетители. Секоја објава може да се подеси различно, но објавата никогаш не може да собере повеќе детални записи отколку оваа конфигурација. На пример, ако сајтот поддржува само место и регион, објавата може да ги избере земјата и регионот или само земјата.";s:50:"admin.settings.statistics.institutions.description";s:576:"Овозможи институционална статистика ако сакаш објавите од овој сајт да можат да собираат корисничка статистика од институциите. На објавите им треба додавање на институции и нивните ИП опсези за да се користат во иднина. Додадвање институционална статистика може значително да ја зголеми вашата база на податоци.";s:50:"admin.settings.statistics.sushi.public.description";s:556:"Дали ќе се направат или нема да се направат SUSHI API тие се јавно достапни за сите објави на овој сајт. Ако овозможите јавни API, секоја објава може да ги препокрие овие подесувања за да ја направат статистиката приватна. Меѓутоа, ако ги оневозможите јавните API, објавите на можат да ги направат јавни нивните API.";s:59:"admin.settings.statistics.sushiPlatform.isSiteSushiPlatform";s:100:"Користете ја страницата како платформа за сите објави.";}}}