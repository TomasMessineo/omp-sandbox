1825506997a:3:{s:6:"domain";N;s:12:"plural-forms";s:78:"nplurals=4; plural=n%100==1 ? 0 : n%100==2 ? 1 : n%100==3 || n%100==4 ? 2 : 3;";s:8:"messages";a:1:{s:0:"";a:41:{s:23:"default.genres.appendix";s:7:"Dodatek";s:27:"default.genres.bibliography";s:13:"Bibliografija";s:25:"default.genres.manuscript";s:14:"Rokopis knjige";s:22:"default.genres.chapter";s:16:"Rokopis poglavja";s:23:"default.genres.glossary";s:6:"Slovar";s:20:"default.genres.index";s:6:"Kazalo";s:22:"default.genres.preface";s:9:"Predgovor";s:25:"default.genres.prospectus";s:8:"Prospekt";s:20:"default.genres.table";s:6:"Tabela";s:21:"default.genres.figure";s:5:"Slika";s:20:"default.genres.photo";s:11:"Fotografija";s:27:"default.genres.illustration";s:11:"Ilustracija";s:20:"default.genres.other";s:5:"Drugo";s:27:"default.groups.name.manager";s:23:"Upravljalec publikacije";s:29:"default.groups.plural.manager";s:23:"Upravljalci publikacije";s:29:"default.groups.abbrev.manager";s:2:"UP";s:26:"default.groups.name.editor";s:2:"UP";s:28:"default.groups.plural.editor";s:20:"Uredniki publikacije";s:28:"default.groups.abbrev.editor";s:2:"UP";s:33:"default.groups.name.sectionEditor";s:14:"Urednik zbirke";s:35:"default.groups.plural.sectionEditor";s:15:"Uredniki zbirke";s:35:"default.groups.abbrev.sectionEditor";s:14:"Urednik zbirke";s:39:"default.groups.name.subscriptionManager";s:17:"Urednik naročnin";s:41:"default.groups.plural.subscriptionManager";s:18:"Uredniki naročnin";s:41:"default.groups.abbrev.subscriptionManager";s:4:"UprN";s:33:"default.groups.name.chapterAuthor";s:14:"Avtor poglavja";s:35:"default.groups.plural.chapterAuthor";s:16:"Avtorji poglavja";s:35:"default.groups.abbrev.chapterAuthor";s:14:"Avtor poglavja";s:32:"default.groups.name.volumeEditor";s:16:"Urednik zbornika";s:34:"default.groups.plural.volumeEditor";s:17:"Uredniki zbornika";s:34:"default.groups.abbrev.volumeEditor";s:16:"Urednik zbornika";s:40:"default.contextSettings.authorGuidelines";s:994:"<p>Avtorji so povabljeni, da oddajo prispevek tej založbi. Tisti prispevki, ki bodo ocenjeni kot primerne, bodo poslani v recenzijo, preden se odloči, ali bodo sprejeti ali zavrnjeni.</p><p>Pred oddajo so avtorji odgovorni za pridobitev dovoljenja za objavo vsega gradiva, vključenega v prispevek, kot so fotografije, dokumenti in podatkovni nizi. Vsi avtorji, navedeni v prispevku, morajo soglašati, da bodo prepoznani kot avtorji. Kjer je primerno, mora biti raziskava odobrena s strani ustreznega etičnega odbora v skladu s pravnimi zahtevami države raziskave.</p><p>Urednik lahko zavrne prispevek, če ne izpolnjuje minimalnih standardov kakovosti. Pred oddajo preverite, ali je obseg in struktura knjige ustrezno zasnovana in izražena. Naslov naj bo jedrnat, povzetek pa naj bo samostojen. To bo povečalo verjetnost, da bodo recenzenti pristali na pregled knjige. Ko boste prepričani, da vaš prispevek izpolnjuje te standarde, sledite spodnjemu seznamu za pripravo prispevka.</p>";s:33:"default.contextSettings.checklist";s:546:"<p>Vse oddaje publikacije morajo izpolnjevati naslednje zahteve.</p><ul><li>Ta oddaja publikacije izpolnjuje zahteve, navedene v <a href="{$submissionGuidelinesUrl}">Navodilih za avtorje</a>.</li><li>Ta oddaja ni bila predhodno objavljena in ni v obravnavi pri drugi založbi.</li><li>Vse reference so bile preverjene glede točnosti in popolnosti.</li><li>Vse tabele in slike so oštevilčene in označene.</li><li>Pridobljeno je bilo dovoljenje za objavo vseh fotografij, podatkovnih nizov in drugega gradiva, priloženega tej oddaji.</li></ul>";s:40:"default.contextSettings.privacyStatement";s:183:"<p>Imena in e-poštni naslovi, vpisani v tem spletišču, se bodo uporabljali striktno le za navedene namene te publikacije in ne bodo predane tretjim osebam za kateri koli namen.</p>";s:40:"default.contextSettings.openAccessPolicy";s:135:"Publikacija je takoj prosto dostopna vsem v prepričanju, da prosta dostopnost do rezultatov raziskav spodbuja večjo izmenjavo znanja.";s:34:"default.contextSettings.forReaders";s:603:"Bralce spodbujamo, da se prijavijo na obvestila o izdajah publikacije založbe. Sledite povezavi <a href="{$indexUrl}/{$contextPath}/user/register">Vpis</a> na vrhu domače strani spletišča. Po registraciji boste po e-pošti prejeli kazalo vsebine vsake nove monografske publikacije na spletišču. Spisek registriranih bralcev pomeni za publikacijo tudi določeno podporo s strani bralcev. Oglejte si <a href="{$indexUrl}/{$contextPath}/about/submissions#privacyStatement">Izjavo o zasebnosti podatkov</a> publikacije, ki bralcem zagotavlja, da imena in e-poštni naslovi bralcev ne bodo zlorabljeni.";s:34:"default.contextSettings.forAuthors";s:552:"Vas zanima objavljanje na tem spletišču? Predlagamo, da si ogledate stran <a href="{$indexUrl}/{$contextPath}/about">O publikaciji</a> za ogled uredniške politike publikacije in strani<a href="{$indexUrl}/{$contextPath}/about/submissions#authorGuidelines">Navodila avtorjem</a>. Avtorji se morajo pred objavo <a href="{$indexUrl}/{$contextPath}/user/register">vpisati</a> pri založbi, če pa so že registrirani, se lahko vanjo enostavno <a href="{$indexUrl}/index/login">prijavijo</a> in začnejo s procesom oddaje prispevka, ki vsebuje 5 korakov.";s:37:"default.contextSettings.forLibrarians";s:309:"Spodbujamo znanstvene knjižnice, da to publikacijo uvrstijo v svojo evidenco elektronskih publikacij. Ta prosto dostopni sistem za objavljanje je prav tako primeren za knjižnice, katerih uslužbenci jo lahko uporabljajo za urejanje publikacij (glej <a href="http://pkp.sfu.ca/omp">Open Monograph Press</a>).";s:36:"default.groups.name.externalReviewer";s:17:"Zunanji recenzent";s:38:"default.groups.plural.externalReviewer";s:18:"Zunanji recenzenti";s:38:"default.groups.abbrev.externalReviewer";s:17:"Zunanji recenzent";}}}