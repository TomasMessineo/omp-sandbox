1825506995a:3:{s:6:"domain";N;s:12:"plural-forms";s:26:"nplurals=2; plural=n != 1;";s:8:"messages";a:1:{s:0:"";a:41:{s:34:"default.groups.abbrev.volumeEditor";s:4:"БР";s:38:"default.groups.plural.externalReviewer";s:42:"Хөндлөнгийн хянагч нар";s:38:"default.groups.abbrev.externalReviewer";s:4:"ХХ";s:23:"default.genres.appendix";s:16:"Хавсралт";s:27:"default.genres.bibliography";s:13:"Ном зүй";s:25:"default.genres.manuscript";s:30:"Номын гар бичмэл";s:22:"default.genres.chapter";s:34:"Бүлгийн гар бичмэл";s:23:"default.genres.glossary";s:38:"Нэр томьёоны тайлбар";s:20:"default.genres.index";s:12:"Индекс";s:22:"default.genres.preface";s:15:"Өмнөх үг";s:25:"default.genres.prospectus";s:33:"Төлөвлөгөө (Prospectus)";s:20:"default.genres.table";s:14:"Хүснэгт";s:21:"default.genres.figure";s:8:"Дүрс";s:20:"default.genres.photo";s:21:"Гэрэл зураг";s:27:"default.genres.illustration";s:44:"Зургийн тайлбар (Illustration)";s:20:"default.genres.other";s:10:"Бусад";s:27:"default.groups.name.manager";s:46:"Хэвлэлийн газрын менежер";s:29:"default.groups.plural.manager";s:52:"Хэвлэлийн газрын менежерүүд";s:29:"default.groups.abbrev.manager";s:6:"ХГМ";s:26:"default.groups.name.editor";s:48:"Хэвлэлийн газрын редактор";s:28:"default.groups.plural.editor";s:54:"Хэвлэлийн газрын редакторууд";s:28:"default.groups.abbrev.editor";s:6:"ХГР";s:33:"default.groups.name.sectionEditor";s:33:"Цувралын редактор";s:35:"default.groups.plural.sectionEditor";s:39:"Цувралын редакторууд";s:35:"default.groups.abbrev.sectionEditor";s:4:"ЦР";s:39:"default.groups.name.subscriptionManager";s:33:"Захиалгын менежер";s:41:"default.groups.plural.subscriptionManager";s:39:"Захиалгын менежерүүд";s:41:"default.groups.abbrev.subscriptionManager";s:4:"ЗМ";s:33:"default.groups.name.chapterAuthor";s:29:"Бүлгийн зохиогч";s:35:"default.groups.plural.chapterAuthor";s:33:"Бүлгийн зохиогчид";s:35:"default.groups.abbrev.chapterAuthor";s:4:"БЗ";s:32:"default.groups.name.volumeEditor";s:29:"Ботийн редактор";s:34:"default.groups.plural.volumeEditor";s:35:"Ботийн редакторууд";s:40:"default.contextSettings.authorGuidelines";s:2061:"<p>Зохиогчдыг энэхүү хэвлэлийн газарт бүтээлээ илгээхийг урьж байна. Хэвлэлийн газрын зорилго, хамрах хүрээнд нийцэж буй илгээлтүүдийг хүлээн авах эсвэл татгалзах эсэхийг шийдэхээс өмнө хөндлөнгийн хяналтад (peer review) илгээнэ.</p><p>Бүтээл илгээхээс өмнө зохиогчид илгээлтэд багтсан гэрэл зураг, баримт бичиг, өгөгдлийн багц зэрэг аливаа материалыг нийтлэх зөвшөөрлийг авах хариуцлагыг хүлээнэ. Илгээлтэд заагдсан бүх зохиогчид зохиогчоор тодорхойлогдохыг зөвшөөрсөн байх ёстой. Шаардлагатай тохиолдолд судалгааг тухайн улсын хууль тогтоомжийн дагуу зохих ёс зүйн хороогоор батлуулсан байх шаардлагатай.</p><p>Хэрэв илгээсэн бүтээл чанарын наад захын стандартад нийцэхгүй бол редактор хяналтын шатанд оруулалгүйгээр шууд татгалзах (desk reject) эрхтэй. Илгээхээсээ өмнө номын хамрах хүрээ болон бүтцийг зөв зохион байгуулж, тодорхой илэрхийлсэн эсэхээ шалгана уу. Гарчиг нь товч бөгөөд хураангуй нь бие даасан утга агуулгатай байх ёстой. Энэ нь хянагч нар таны номыг хянаж үзэхээр зөвшөөрөх магадлалыг нэмэгдүүлнэ. Та өөрийн илгээлтээ энэхүү стандартад нийцсэн гэж үзвэл доорх хяналтын хуудасны дагуу илгээлтээ бэлтгэнэ үү.</p>";s:33:"default.contextSettings.checklist";s:962:"<p>Бүх илгээлтүүд дараах шаардлагыг хангасан байх ёстой.</p><ul><li>Энэхүү илгээлт нь <a href="{$submissionGuidelinesUrl}">Зохиогчид зориулсан зааварчилгаа</a> хэсэгт заасан шаардлагыг хангасан.</li><li>Энэхүү бүтээл нь өмнө нь хэвлэгдээгүй бөгөөд өөр ямар нэгэн хэвлэлийн газарт хянан үзэхээр илгээгдээгүй болно.</li><li>Бүх ишлэл, ном зүйн үнэн зөв, бүрэн байдлыг шалгасан.</li><li>Бүх хүснэгт, дүрсүүдийг дугаарлаж, тайлбар бичсэн.</li><li>Энэхүү илгээлттэй хамт ирүүлсэн бүх гэрэл зураг, өгөгдлийн багц болон бусад материалыг нийтлэх зөвшөөрлийг авсан.</li></ul>";s:40:"default.contextSettings.privacyStatement";s:308:"<p>Энэхүү хэвлэлийн газрын сайтад орсон нэр, имэйл хаягийг зөвхөн хэвлэлийн газрын заасан зорилгоор ашиглах бөгөөд өөр зорилгоор ашиглахгүй, бусад талд дамжуулахгүй.</p>";s:40:"default.contextSettings.openAccessPolicy";s:323:"Энэхүү хэвлэлийн газар нь судалгааг олон нийтэд чөлөөтэй нээлттэй болгох нь дэлхийн мэдлэгийн солилцоог дэмжинэ гэсэн зарчмын дагуу агуулгадаа шууд нээлттэй хандалт олгодог.";s:34:"default.contextSettings.forReaders";s:1172:"Бид уншигчдыг энэхүү хэвлэлийн газрын нийтлэлийн мэдэгдлийн үйлчилгээнд бүртгүүлэхийг уриалж байна. Хэвлэлийн газрын нүүр хуудасны дээд хэсэгт байрлах <a href="{$indexUrl}/{$contextPath}/user/register">Бүртгүүлэх</a> холбоосыг ашиглана уу. Ингэснээр уншигч хэвлэлийн газраас гаргаж буй шинэ нэг сэдэвт бүтээл бүрийн гарчгийн жагсаалтыг имэйлээр хүлээн авах болно. Энэхүү жагсаалт нь мөн хэвлэлийн газарт тодорхой түвшний дэмжлэг эсвэл уншигчдын тоог харуулах боломжийг олгодог. Хэвлэлийн газрын <a href="{$indexUrl}/{$contextPath}/about/submissions#privacyStatement">Нууцлалын мэдэгдэл</a>-тэй танилцана уу. Энэ нь уншигчдын нэр, имэйл хаягийг бусад зорилгоор ашиглахгүй байх баталгаа болно.";s:34:"default.contextSettings.forAuthors";s:876:"Энэхүү хэвлэлийн газарт бүтээлээ илгээх сонирхолтой байна уу? Цувралын бодлоготой танилцахын тулд <a href="{$indexUrl}/{$contextPath}/about">Хэвлэлийн газрын тухай</a> хуудсыг, мөн <a href="{$indexUrl}/{$contextPath}/about/submissions#authorGuidelines">Зохиогчид зориулсан зааварчилгаа</a>-г үзэхийг зөвлөж байна. Зохиогчид бүтээлээ илгээхээсээ өмнө хэвлэлийн газарт <a href="{$indexUrl}/{$contextPath}/user/register">бүртгүүлэх</a> шаардлагатай бөгөөд хэрэв аль хэдийн бүртгүүлсэн бол <a href="{$indexUrl}/index/login">нэвтэрч</a> ороод 5 алхамт үйл явцыг эхлүүлж болно.";s:37:"default.contextSettings.forLibrarians";s:656:"Бид судалгааны номын санчдыг энэхүү хэвлэлийн газрыг өөрийн номын сангийн цахим хэвлэлийн жагсаалтад оруулахыг уриалж байна. Мөн энэхүү нээлттэй эх бүхий хэвлэлийн систем нь номын сангууд өөрийн багш, ажилтнуудынхаа эрхлэн гаргаж буй хэвлэлийн газруудыг байршуулахад тохиромжтой гэдгийг дурдах нь зүйтэй болов уу (<a href="https://pkp.sfu.ca/omp">Open Monograph Press</a> үзнэ үү).";s:36:"default.groups.name.externalReviewer";s:35:"Хөндлөнгийн хянагч";}}}