1825506997a:3:{s:6:"domain";N;s:12:"plural-forms";s:78:"nplurals=4; plural=n%100==1 ? 0 : n%100==2 ? 1 : n%100==3 || n%100==4 ? 2 : 3;";s:8:"messages";a:1:{s:0:"";a:38:{s:20:"admin.hostedContexts";s:19:"Gostujoče založbe";s:33:"admin.settings.appearance.success";s:64:"Nastavitve izgleda spletne strani so bile uspešno posodobljene.";s:29:"admin.settings.config.success";s:70:"Nastavitve konfiguracije spletne strani so bile uspešno posodobljene.";s:27:"admin.settings.info.success";s:59:"Informacije o spletni strani so bile uspešno posodobljene.";s:23:"admin.settings.redirect";s:21:"Preusmeritev založbe";s:35:"admin.settings.redirectInstructions";s:123:"Vse prošnje na glavnem mestu bodo preusmerjene na to založbo. To je uporabno, če na spletišču gostuje le ena založba.";s:30:"admin.settings.noPressRedirect";s:12:"Ne preusmeri";s:41:"admin.languages.primaryLocaleInstructions";s:63:"Ta bo privzeti jezik za spletišče in vse gostujoče založbe.";s:44:"admin.languages.supportedLocalesInstructions";s:417:"Izberi vse območne jezike, ki bodo podprte na tem spletišču. Izbrani območni jeziki bodo na voljo za vse gostujoče založbe in se bodo pojavljali na meniju možnih jezikov na vsaki spletni strani (to lahko spremenite na straneh založbe). Če ne bo izbranih več območnih jezikov, se na spletnih straneh ne bo pojavil meni za spreminjanje jezika in razširjene jezikovne nastavitve ne bodo na voljo za založbe.";s:28:"admin.locale.maybeIncomplete";s:46:"*Označeni območni jeziki so lahko nepopolni.";s:32:"admin.languages.confirmUninstall";s:150:"Ali ste prepričani, da želite odstraniti ta območni jezik? To bo lahko vplivalo na vse gostujoče založbe, ki trenutno uporabljajo območni jezik.";s:45:"admin.languages.installNewLocalesInstructions";s:247:"Izberite dodatne območne jezike, ki jih želite imeti na voljo na tem spletišču. Območni jeziki morajo biti nameščeni, preden jih gostujoča založba lahko uporablja. V dokumentaciji OMP lahko najdete več informacij o podpori novim jezikov.";s:30:"admin.languages.confirmDisable";s:152:"Ali ste prepričani, da želite onemogočiti ta območni jezik? To bo lahko vplivalo na vse gostujoče založbe, ki trenutno uporabljajo območni jezik.";s:19:"admin.systemVersion";s:14:"Različica OMP";s:25:"admin.systemConfiguration";s:14:"Nastavitve OMP";s:27:"admin.presses.pressSettings";s:19:"Nastavitve založbe";s:25:"admin.presses.noneCreated";s:35:"Nobena založba ni bila ustvarjena.";s:21:"admin.contexts.create";s:16:"Ustvari založbo";s:33:"admin.contexts.form.titleRequired";s:18:"Naslov je obvezen.";s:32:"admin.contexts.form.pathRequired";s:15:"Pot je obvezna.";s:36:"admin.contexts.form.pathAlphaNumeric";s:126:"Pot lahko vsebuje le alfanumerične znake, podčrtaje in pomišljaje ter se mora začeti in končati z alfanumeričnim znakom.";s:30:"admin.contexts.form.pathExists";s:41:"Izbrano pot uporablja že druga založba.";s:45:"admin.contexts.form.primaryLocaleNotSupported";s:58:"Primarni jezik mora biti eden od podprtih jezikov portala.";s:34:"admin.contexts.form.create.success";s:34:"{$name} je bil uspešno ustvarjen.";s:32:"admin.contexts.form.edit.success";s:31:"{$name} je bil uspešno urejen.";s:33:"admin.contexts.contextDescription";s:13:"Opis založbe";s:22:"admin.presses.addPress";s:14:"Dodaj založbo";s:37:"admin.overwriteConfigFileInstructions";s:252:"<h4>OPOZORILO!</div>
<p>Sistem ne more samodejno prepisati nastavitvene datoteke. Za ročni vpis sprememb v nastavitveno datoteko <tt>config.inc.php</tt> jo odprite v primernem urejevalniku besedil in zamenjajte vsebino datoteke z besedilom spodaj.</p>";s:43:"admin.settings.enableBulkEmails.description";s:803:"Izberite gostovane založbe, ki jim bo omogočeno pošiljanje množičnih e-poštnih sporočil. Ko je ta funkcija omogočena, bo upravitelj založbe lahko poslal e-poštno sporočilo vsem uporabnikom, registriranim pri njihovi založbi.<br><br>Zloraba te funkcije za pošiljanje nezaželenih e-poštnih sporočil lahko krši zakone proti neželeni pošti v nekaterih jurisdikcijah in lahko povzroči, da bodo e-poštna sporočila vašega strežnika označena kot neželena pošta. Pred omogočanjem te funkcije poiščite tehnične nasvete in razmislite o posvetovanju z upravitelji založb, da zagotovite, da se uporablja ustrezno.<br><br>Dodatne omejitve za to funkcijo lahko omogočite za vsako založbo z obiskom čarovnika nastavitev v seznamu <a href="{$hostedContextsUrl}">Gostovanih založb</a>.";s:48:"admin.settings.disableBulkEmailRoles.description";s:541:"Upravitelj založbe ne bo mogel pošiljati množičnih e-poštnih sporočil nobeni od spodaj izbranih vlog. To nastavitev uporabite za omejitev zlorabe funkcije obvestil po e-pošti. Na primer, morda bo varneje onemogočiti množična e-poštna sporočila za bralce, avtorje ali druge velike uporabniške skupine, ki niso soglašale s prejemanjem takšnih e-poštnih sporočil.<br><br>Funkcijo množičnih e-poštnih sporočil lahko popolnoma onemogočite za to založbo v <a href="{$siteSettingsUrl}">Admin > Nastavitve spletnega mesta</a>.";s:52:"admin.settings.disableBulkEmailRoles.contextDisabled";s:172:"Funkcija množičnih e-poštnih sporočil je bila onemogočena za to založbo. Omogočite to funkcijo v <a href="{$siteSettingsUrl}">Admin > Nastavitve spletnega mesta</a>.";s:32:"admin.siteManagement.description";s:108:"Dodaj, urejaj ali odstrani založbe s tega spletnega mesta in upravljaj nastavitve za celotno spletno mesto.";s:50:"admin.job.processLogFile.invalidLogEntry.chapterId";s:28:"ID poglavja ni celo število";s:49:"admin.job.processLogFile.invalidLogEntry.seriesId";s:26:"ID zbirke ni celo število";s:41:"admin.settings.statistics.geo.description";s:566:"Izberite vrsto geografske statistike uporabe, ki jo lahko zbirajo založbe na tem spletnem mestu. Podrobnejše geografske statistike lahko znatno povečajo velikost vaše baze podatkov in v nekaterih redkih primerih lahko ogrozijo anonimnost vaših obiskovalcev. Vsaka založba lahko to nastavitev konfigurira drugače, vendar založba ne more zbirati podrobnejših zapisov, kot so nastavljeni tukaj. Na primer, če spletno mesto podpira le državo in regijo, lahko založba izbere državo in regijo ali samo državo. Založba ne bo mogla spremljati regije in mesta.";s:50:"admin.settings.statistics.institutions.description";s:331:"Omogočite institucionalne statistike, če želite, da založbe na tem spletnem mestu lahko zbirajo statistike uporabe po institucijah. Založbe bodo morale dodati institucijo in njen obseg IP-naslovov, da bodo lahko uporabile to funkcijo. Omogočanje institucionalnih statistikov lahko znatno poveča velikost vaše baze podatkov.";s:50:"admin.settings.statistics.sushi.public.description";s:290:"Ali naj bodo SUSHI API končne točke javno dostopne za vse založbe na tem spletnem mestu. Če omogočite javni API, lahko vsaka založba prekliče to nastavitev in svoje statistike nastavi kot zasebne. Če pa onemogočite javni API, založbe ne bodo mogle narediti svojega API-ja javnega.";s:59:"admin.settings.statistics.sushiPlatform.isSiteSushiPlatform";s:48:"Uporabi strežnik kot platformo za vse založbe.";}}}