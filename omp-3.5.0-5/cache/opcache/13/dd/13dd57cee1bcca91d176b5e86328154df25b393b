1825506994a:3:{s:6:"domain";N;s:12:"plural-forms";s:100:"nplurals=3; plural=n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2;";s:8:"messages";a:1:{s:0:"";a:38:{s:20:"admin.hostedContexts";s:6:"Mediji";s:33:"admin.settings.appearance.success";s:50:"Postavke izgleda stranice uspješno su ažurirane.";s:29:"admin.settings.config.success";s:56:"Postavke konfiguracije stranice uspješno su ažurirane.";s:23:"admin.settings.redirect";s:29:"Preusmjeravanje na nakladnika";s:32:"admin.siteManagement.description";s:97:"Dodajte, uredite ili uklonite medije s ove stranice i upravljajte postavkama na cijeloj stranici.";s:50:"admin.settings.statistics.sushi.public.description";s:280:"Učiniti SUSHI API krajnje točke javno dostupne za sve medije na ovoj stranici ili ne. Ako omogućite javni API, svaki medij može nadjačati ovu postavku kako bi njegova statistika postala privatnom. Međutim, ako onemogućite javni API, mediji ne mogu učiniti svoj API javnim.";s:27:"admin.settings.info.success";s:42:"Podaci o stranici uspješno su ažurirani.";s:35:"admin.settings.redirectInstructions";s:154:"Zahtjevi za glavnu stranicu bit će preusmjereni na ovog nakladnika. Ovo može biti korisno ako web mjesto, na primjer, samo jednog nakladnika ugošćuje.";s:30:"admin.settings.noPressRedirect";s:17:"Ne preusmjeravati";s:41:"admin.languages.primaryLocaleInstructions";s:66:"Ovo će biti zadani jezik za stranicu i sve ugošćene nakladnike.";s:28:"admin.locale.maybeIncomplete";s:41:"* Označene lokacije mogu biti nepotpune.";s:44:"admin.languages.supportedLocalesInstructions";s:465:"Odaberite sve lokalne postavke za podršku na web mjestu. Odabrane postavke bit će dostupne za korištenje svim medijima koji se nalaze na stranici, a također će se pojaviti u izborniku za odabir jezika koji će se pojaviti na svakoj stranici web-mjesta (što se može nadjačati na stranicama specifičnim za medije). Ako nije odabrano više jezika, izbornik za prebacivanje jezika neće se pojaviti, a proširene jezične postavke neće biti dostupne medijima.";s:32:"admin.languages.confirmUninstall";s:136:"Jeste li sigurni da želite deinstalirati ove lokalne postavke? To može utjecati na bilo koji medij koji trenutno koristi ove postavke.";s:45:"admin.languages.installNewLocalesInstructions";s:235:"Odaberite sve dodatne lokalne postavke za instaliranje podrške u ovom sustavu. Lokacije moraju biti instalirane prije nego što ih mogu koristiti mediji. Pogledajte OMP dokumentaciju za informacije o dodavanju podrške za nove jezike.";s:30:"admin.languages.confirmDisable";s:139:"Jeste li sigurni da želite onemogućiti ove lokalne postavke? To može utjecati na bilo koji medij koji trenutno koristi lokalne postavke.";s:19:"admin.systemVersion";s:11:"OMP verzija";s:25:"admin.systemConfiguration";s:17:"OMP konfiguracija";s:27:"admin.presses.pressSettings";s:18:"Postavke za medije";s:25:"admin.presses.noneCreated";s:26:"Nisu još stvoreni mediji.";s:21:"admin.contexts.create";s:12:"Stvori medij";s:33:"admin.contexts.form.titleRequired";s:19:"Potreban je naslov.";s:32:"admin.contexts.form.pathRequired";s:20:"Potrebna je putanja.";s:36:"admin.contexts.form.pathAlphaNumeric";s:108:"Putanja može sadržavati samo slova, brojeve i znakove _ i -. Mora započeti i završiti slovom ili brojem.";s:30:"admin.contexts.form.pathExists";s:42:"Odabranu putanju već koristi drugi medij.";s:45:"admin.contexts.form.primaryLocaleNotSupported";s:76:"Primarne lokalne postavke moraju biti jedne od podržanih lokalnih postavki.";s:34:"admin.contexts.form.create.success";s:29:"{$name} uspješno je kreiran.";s:32:"admin.contexts.form.edit.success";s:29:"{$name} uspješno je uređen.";s:33:"admin.contexts.contextDescription";s:11:"Opis medija";s:22:"admin.presses.addPress";s:11:"Dodaj medij";s:37:"admin.overwriteConfigFileInstructions";s:286:"<h4>NAPOMENA!</div>
<p>Sustav nije mogao automatski prebrisati konfiguracijsku datoteku. Da biste primijenili svoje konfiguracijske promjene, morate otvoriti <tt>config.inc.php</tt> u odgovarajućem uređivaču teksta i zamijeniti njegov sadržaj sadržajem tekstualnog polja ispod.</p>";s:43:"admin.settings.enableBulkEmails.description";s:768:"Odaberite medije kojima bi se trebalo dopustiti skupno slanje e-pošte. Kada je ova značajka omogućena, upravitelj medija moći će poslati e-poštu svim korisnicima koji su registrirani u njihovom mediju.<br><br>Zlouporaba ove značajke za slanje neželjene e-pošte može kršiti zakone protiv neželjene pošte u nekim jurisdikcijama i može rezultirati da je e-pošta vašeg poslužitelja blokirana kao neželjena pošta. Zatražite tehnički savjet prije nego što omogućite ovu značajku i razmislite o savjetovanju s voditeljima medija kako biste osigurali da se koristi na odgovarajući način.<br><br>Daljnja ograničenja ove značajke mogu se omogućiti za svaki medij posjetom čarobnjaka za postavke na popisu <a href= "{$hostedContextsUrl}">Mediji</a>.";s:48:"admin.settings.disableBulkEmailRoles.description";s:493:"Voditelj medija neće moći slati skupne poruke e-pošte nijednoj od dolje odabranih uloga. Koristite ovu postavku za ograničavanje zlouporabe značajke obavijesti e-poštom. Na primjer, možda bi bilo sigurnije onemogućiti skupnu e-poštu čitateljima, autorima ili drugim velikim grupama korisnika koji nisu pristali primati takve e-poruke.<br><br>Značajka skupne e-pošte može se potpuno onemogućiti za ovaj medij u <a href="{$siteSettingsUrl}">Administrator > Postavke web-mjesta</a>.";s:52:"admin.settings.disableBulkEmailRoles.contextDisabled";s:153:"Značajka skupne e-pošte onemogućena je za ovaj medij. Omogućite ovu značajku u <a href="{$siteSettingsUrl}">Administrator > Postavke web-mjesta</a>.";s:50:"admin.job.processLogFile.invalidLogEntry.chapterId";s:29:"Poglavlje ID nije cijeli broj";s:49:"admin.job.processLogFile.invalidLogEntry.seriesId";s:26:"Serija ID nije cijeli broj";s:41:"admin.settings.statistics.geo.description";s:573:"Odaberite vrstu zemljopisne statistike korištenja koju mogu prikupiti mediji na ovoj stranici. Detaljnija geografska statistika može značajno povećati veličinu vaše baze podataka i u nekim rijetkim slučajevima može potkopati anonimnost vaših posjetitelja. Svaki medij može drugačije konfigurirati ovu postavku, ali medij nikada ne može prikupiti detaljnije zapise od onih koji su ovdje konfigurirani. Na primjer, ako stranica podržava samo zemlju i regiju, medij može odabrati zemlju i regiju ili samo zemlju. Medij neće moći pratiti državu, regiju i grad.";s:50:"admin.settings.statistics.institutions.description";s:318:"Omogućite institucionalnu statistiku ako želite da mediji na ovoj stranici mogu prikupljati statistiku korištenja po instituciji. Mediji će morati dodati ustanovu i njezine IP raspone kako bi koristili ovu značajku. Omogućavanje institucionalne statistike može značajno povećati veličinu vaše baze podataka.";s:59:"admin.settings.statistics.sushiPlatform.isSiteSushiPlatform";s:50:"Koristite stranicu kao platformu za sve časopise.";}}}