1825506993a:3:{s:6:"domain";N;s:12:"plural-forms";s:26:"nplurals=2; plural=n != 1;";s:8:"messages";a:1:{s:0:"";a:41:{s:27:"default.genres.bibliography";s:24:"Библиография";s:22:"default.genres.chapter";s:48:"Ръкопис на раздел от книга";s:23:"default.genres.glossary";s:12:"Речник";s:20:"default.genres.index";s:12:"Индекс";s:22:"default.genres.preface";s:18:"Предговор";s:20:"default.genres.table";s:14:"Таблица";s:21:"default.genres.figure";s:12:"Фигура";s:20:"default.genres.photo";s:20:"Фотография";s:20:"default.genres.other";s:10:"Друго";s:27:"default.groups.name.manager";s:44:"Мениджър на издателство";s:29:"default.groups.plural.manager";s:46:"Мениджъри на издателство";s:29:"default.groups.abbrev.manager";s:4:"МИ";s:28:"default.groups.plural.editor";s:46:"Редактори на издателство";s:28:"default.groups.abbrev.editor";s:4:"РИ";s:35:"default.groups.abbrev.sectionEditor";s:4:"РС";s:39:"default.groups.name.subscriptionManager";s:40:"Мениджър на абонамент";s:41:"default.groups.plural.subscriptionManager";s:42:"Мениджъри на абонамент";s:41:"default.groups.abbrev.subscriptionManager";s:4:"МА";s:33:"default.groups.name.chapterAuthor";s:44:"Автор на раздел от книга";s:35:"default.groups.plural.chapterAuthor";s:46:"Автори на раздел от книга";s:35:"default.groups.abbrev.chapterAuthor";s:4:"АР";s:34:"default.groups.plural.volumeEditor";s:30:"Редактори на том";s:34:"default.groups.abbrev.volumeEditor";s:4:"РТ";s:38:"default.groups.plural.externalReviewer";s:33:"Външни рецензенти";s:38:"default.groups.abbrev.externalReviewer";s:4:"ВР";s:23:"default.genres.appendix";s:20:"Приложение";s:25:"default.genres.manuscript";s:30:"Ръкопис на книга";s:25:"default.genres.prospectus";s:16:"Проспект";s:27:"default.genres.illustration";s:20:"Илюстрация";s:26:"default.groups.name.editor";s:44:"Редактор на издателство";s:33:"default.groups.name.sectionEditor";s:51:"Редактор на серия (колекция)";s:35:"default.groups.plural.sectionEditor";s:53:"Редактори на серия (колекция)";s:32:"default.groups.name.volumeEditor";s:28:"Редактор на том";s:40:"default.contextSettings.authorGuidelines";s:2137:"<p>Авторите са поканени да изпратят материали към това издателство. Изпратените материали, които се считат за подходящи, ще бъдат изпратени за рецензиране, преди да се определи дали ще бъдат приети или отхвърлени.</p><p>Преди да направят изпращане, авторите носят отговорност за получаване на разрешение за публикуване на всеки материал, включен в подаването , като снимки, документи и набори от данни. Всички автори, посочени в подаването, трябва да дадат съгласието си да бъдат идентифицирани като автори. Когато е уместно, изследването трябва да бъде одобрено от съответна комисия по етика в съответствие със законовите изисквания на държавата на изследването.</p><p>Редакторът може да отхвърли подаването, ако то не отговаря на минималните стандарти за качество. Преди да изпратите, моля, уверете се, че обхватът и схемата на книгата са структурирани и формулирани правилно. Заглавието трябва да е кратко и резюмето трябва да може да стои самостоятелно. Това ще увеличи вероятността рецензенти да се съгласят да прегледат книгата. Когато сте доволни, че подаването ви отговаря на този стандарт, моля, следвайте контролния списък по-долу, за да подготвите подаването си.</p>";s:33:"default.contextSettings.checklist";s:978:"<p>Всички изпратени материали трябва да отговарят на следните изисквания.</p><ul><li>Тeзи изпращани материали отговарят на изискванията, посочени в <a href="{$submissionGuidelinesUrl}">Указанията за авторите</a>.</li ><li>Това представяне не е публикувано преди, нито подадено пред друго издателство за разглеждане.</li><li>Всички препратки са проверени за точност и пълнота.</li><li>Всички таблици и фигури са е номерирани и етикетирани.</li><li>Получено е разрешение за публикуване на всички снимки, набори от данни и други материали, предоставени с това изпращане.</li></ul>";s:40:"default.contextSettings.privacyStatement";s:351:"<p>Имената и имейл адресите, въведени в този сайт на издателството, ще бъдат използвани изключително за посочените цели и няма да бъдат предоставяни за никакви други цели или на друга страна.</p>";s:40:"default.contextSettings.openAccessPolicy";s:384:"Това издателство предоставя незабавен отворен достъп до съдържанието си на принципа, че предоставянето на научните изследвания свободно достъпни за обществеността подкрепя по-голям глобален обмен на знания.";s:34:"default.contextSettings.forReaders";s:1220:"Насърчаваме читателите да се запишат за услугата за публикуване на известия на това издателство. Използвайте връзката <a href="{$indexUrl}/{$contextPath}/user/register">Регистрация</a> в горната част на началната страница за издателството. Тази регистрация ще доведе до това, че читателят ще получава съдържанието по имейл за всяка нова монография публикувана от издателството. Този списък също така позволява на издателството да претендира за определено ниво на подкрепа или читателска аудитория. Вижте издателската <a href="{$indexUrl}/{$contextPath}/about/submissions#privacyStatement">Декларация за поверителност</a>, която гарантира на читателите, че тяхното име и имейл адрес няма да бъдат използвани за други цели.";s:34:"default.contextSettings.forAuthors";s:803:"Интересувате ли се от изпращане на материал в това издателство? Препоръчваме ви да прегледате страницата <a href="{$indexUrl}/{$contextPath}/about">Относно издателството</a> за правилата на секцията и <a href="{$indexUrl}/{ $contextPath}/about/submissions#authorGuidelines">Указания за автор</a>. Авторите трябва да <a href="{$indexUrl}/{$contextPath}/user/register">се регистрират</a> в издателството, преди да изпратят, или ако вече са регистрирани, могат да <a href="{$indexUrl} /index/login">влязат</a> и започнат процеса от 5 стъпки.";s:37:"default.contextSettings.forLibrarians";s:685:"Насърчаваме изследователите в библиотеките да включат това издателство в електронния каталог на библиотеката си. Също така, тази система за публикуване с отворен код е подходяща за библиотеки, които да хостват електронни публикационни системи за членовете си и издават електронни и печатни издания и/или участват в редактирането им (вижте <a href="https://pkp.sfu.ca/omp">Open Monograph Press </a>).";s:36:"default.groups.name.externalReviewer";s:31:"Външен рецензент";}}}